# ==============================================================================
# NE-SAFE AI - Git Ignore Configuration
# ==============================================================================

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Local Environment Variables & Secrets (CRITICAL: NEVER COMMIT REAL KEYS)
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key
*.cert
*.p12

# Databases & Local Persistent Storage
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3
backend/reports/*.pdf

# Node & Frontend Build Artifacts
node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.vite/
**/temp/
*.tsbuildinfo

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
