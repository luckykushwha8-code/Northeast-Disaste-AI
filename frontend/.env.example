# NE-SAFE AI Frontend Environment Configuration
# Optional: Set backend API base URL. Defaults to http://127.0.0.1:8000/api/v1 if unset.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# MapTiler API key for basemap tiles (get yours at https://cloud.maptiler.com/account/keys/)
# Required for vector basemaps. Falls back to OSM raster if missing.
VITE_MAPTILER_API_KEY=
