# NE-SAFE AI backend environment — copy to .env and fill in real keys
# NOTE: never commit a real .env; real keys live only on your machine.

APP_ENV=development
DATABASE_URL=sqlite:///./ne_safe.db

FRONTEND_ORIGIN=http://localhost:5173

# ---- Official data sources ----
CWC_BASE_URL=https://ffs.india-water.gov.in/
GSI_BASE_URL=https://bhusanket.gsi.gov.in/

# ---- Automatic public alert emails (KEEP OFF until data + model are validated) ----
# SMTP acceptance is recorded as ACCEPTED_BY_PROVIDER, never as "delivered".
# Authority contacts per district, JSON: AUTHORITY_CONTACTS_JSON={"District":["email"]}
# Contacts must be verified with the district disaster-management authority first.
PUBLIC_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=ne-safe-ai@noreply.example.org
SMTP_TIMEOUT_SECONDS=15
ALERT_MAX_STALE_HOURS=3
AUTHORITY_CONTACTS_JSON={}

REQUEST_TIMEOUT_SECONDS=10

# ---- Staff authentication (fail closed until configured) ----
# Generate a password hash in backend with: python -m app.auth hash-password
# AUTH_USERS_JSON maps usernames to {"role":"OPERATOR","password_hash":"pbkdf2_sha256$..."}
AUTH_SECRET_KEY=
AUTH_USERS_JSON={}
AUTH_TOKEN_TTL_MINUTES=480

# ---- Optional Gemini assistance (server-side only; never use VITE_ variables) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=false
GEMINI_TIMEOUT_SECONDS=15
GEMINI_RATE_LIMIT_PER_MINUTE=8

# ---- TinyFish (agent-assisted page fetch; optional) ----
TINYFISH_API_KEY=
TINYFISH_API_URL=https://api.fetch.tinyfish.ai
TINYFISH_TIMEOUT_SECONDS=15
TINYFISH_RATE_LIMIT_PER_MINUTE=30

# ---- Open-Meteo rainfall gap-fill (key-free) ----
OPEN_METEO_ENABLED=true
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=8

# ---- Scheduler automation ----
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=30
